<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Settings"
        app:titleTextAppearance="@style/TextAppearance.BlogExpress.ToolbarTitle"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Profile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                style="@style/BlogExpress.SettingsCard"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_icon_box">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtProfileEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtProfileStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView style="@style/BlogExpress.RowChevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences -->
            <TextView
                style="@style/BlogExpress.SectionHeader"
                android:text="Preferences" />

            <com.google.android.material.card.MaterialCardView style="@style/BlogExpress.SettingsCard">

                <LinearLayout
                    android:id="@+id/rowDarkMode"
                    style="@style/BlogExpress.SettingsRow">

                    <FrameLayout style="@style/BlogExpress.SettingsIconBox">
                        <ImageView
                            style="@style/BlogExpress.SettingsIcon"
                            android:src="@drawable/ic_dark_mode" />
                    </FrameLayout>

                    <LinearLayout style="@style/BlogExpress.RowText">
                        <TextView
                            style="@style/BlogExpress.RowTitle"
                            android:text="Dark Mode" />
                        <TextView
                            android:id="@+id/txtDarkSubtitle"
                            style="@style/BlogExpress.RowSubtitle" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Online publishing -->
            <TextView
                style="@style/BlogExpress.SectionHeader"
                android:text="Online publishing" />

            <com.google.android.material.card.MaterialCardView style="@style/BlogExpress.SettingsCard">

                <LinearLayout
                    android:id="@+id/rowWordPress"
                    style="@style/BlogExpress.SettingsRow">

                    <FrameLayout style="@style/BlogExpress.SettingsIconBox">
                        <ImageView
                            style="@style/BlogExpress.SettingsIcon"
                            android:src="@drawable/ic_upload" />
                    </FrameLayout>

                    <LinearLayout style="@style/BlogExpress.RowText">
                        <TextView
                            style="@style/BlogExpress.RowTitle"
                            android:text="WordPress Account" />
                        <TextView
                            android:id="@+id/txtWordPressStatus"
                            style="@style/BlogExpress.RowSubtitle" />
                    </LinearLayout>

                    <ImageView style="@style/BlogExpress.RowChevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Storage -->
            <TextView
                style="@style/BlogExpress.SectionHeader"
                android:text="Storage" />

            <com.google.android.material.card.MaterialCardView style="@style/BlogExpress.SettingsCard">

                <LinearLayout
                    android:id="@+id/rowStorage"
                    style="@style/BlogExpress.SettingsRow">

                    <FrameLayout style="@style/BlogExpress.SettingsIconBox">
                        <ImageView
                            style="@style/BlogExpress.SettingsIcon"
                            android:src="@drawable/ic_storage" />
                    </FrameLayout>

                    <LinearLayout style="@style/BlogExpress.RowText">
                        <TextView
                            style="@style/BlogExpress.RowTitle"
                            android:text="Local Storage" />
                        <TextView
                            android:id="@+id/txtStorage"
                            style="@style/BlogExpress.RowSubtitle" />
                    </LinearLayout>

                    <ImageView style="@style/BlogExpress.RowChevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView
                style="@style/BlogExpress.SectionHeader"
                android:text="About" />

            <com.google.android.material.card.MaterialCardView style="@style/BlogExpress.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAbout"
                        style="@style/BlogExpress.SettingsRow">

                        <FrameLayout style="@style/BlogExpress.SettingsIconBox">
                            <ImageView
                                style="@style/BlogExpress.SettingsIcon"
                                android:src="@drawable/ic_info" />
                        </FrameLayout>

                        <LinearLayout style="@style/BlogExpress.RowText">
                            <TextView
                                style="@style/BlogExpress.RowTitle"
                                android:text="About BlogExpress" />
                            <TextView
                                android:id="@+id/txtVersion"
                                style="@style/BlogExpress.RowSubtitle" />
                        </LinearLayout>

                        <ImageView style="@style/BlogExpress.RowChevron" />
                    </LinearLayout>

                    <View style="@style/BlogExpress.RowDivider" />

                    <LinearLayout
                        android:id="@+id/rowPrivacy"
                        style="@style/BlogExpress.SettingsRow">

                        <FrameLayout style="@style/BlogExpress.SettingsIconBox">
                            <ImageView
                                style="@style/BlogExpress.SettingsIcon"
                                android:src="@drawable/ic_shield" />
                        </FrameLayout>

                        <LinearLayout style="@style/BlogExpress.RowText">
                            <TextView
                                style="@style/BlogExpress.RowTitle"
                                android:text="Privacy &amp; Security" />
                            <TextView
                                style="@style/BlogExpress.RowSubtitle"
                                android:text="Your data stays on your device" />
                        </LinearLayout>

                        <ImageView style="@style/BlogExpress.RowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOut"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Sign Out"
                android:textColor="@color/danger"
                android:textSize="15sp"
                app:backgroundTint="@color/danger_light"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/danger" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>